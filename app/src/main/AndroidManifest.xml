<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
        android:name=".MeldApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Meld">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Meld">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".receiver.BootReceiver"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- IntentReceiver is intentionally exported with no permission restriction.
             The design goal is to allow automation apps (Tasker, Macrodroid, ADB, etc.)
             to activate/deactivate modes without requiring a custom permission. -->
        <receiver
            android:name=".receiver.IntentReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="meld.intent.SET_MODE" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".tasker.AddToContextActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.EDIT_SETTING" />
                <category android:name="com.twofortyfouram.locale.intent.category.PLUGIN_SETTING" />
            </intent-filter>
        </activity>

        <activity
            android:name=".tasker.RemoveFromContextActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.EDIT_SETTING" />
                <category android:name="com.twofortyfouram.locale.intent.category.PLUGIN_SETTING" />
            </intent-filter>
        </activity>
    </application>
</manifest>
